#!/usr/bin/env bash
set -eo pipefail

HARNESS_DIR="$HOME/.config/hypr/harness"
STATE_FILE="/tmp/hypr-voice-record.pid"
AUDIO_FILE="/tmp/hypr-voice-input.wav"

# 1. Manual early cancel/submit: If already running, pressing keybind again cuts it off immediately
if [[ -f "$STATE_FILE" ]]; then
  REC_PID=$(cat "$STATE_FILE" 2>/dev/null || true)
  rm -f "$STATE_FILE"
  if [[ -n "$REC_PID" ]]; then
    # Signal the bun process directly so it flushes the audio file and exits
    kill -SIGINT "$REC_PID" 2>/dev/null || true
    # Also signal any child processes in its process group
    pkill -P "$REC_PID" -SIGINT 2>/dev/null || true
  fi
  exit 0
fi

# 2. Start recording with streaming Voice Activity Detection (auto-stops on silence or manual re-press)
notify-send -a "hypr-voice" -u normal -t 8000 "Voice Input" "🎙️ Listening... (Speak now; auto-detects when you finish)"

# Launch background worker
(
  # Spawn VAD recorder in background and store its PID in STATE_FILE
  bun run "$HARNESS_DIR/vad_record.ts" "$AUDIO_FILE" >/dev/null 2>&1 &
  BUN_PID=$!
  echo "$BUN_PID" > "$STATE_FILE"

  # Wait for VAD recorder to finish (either via silence auto-detection, timeout, or manual SIGINT)
  wait "$BUN_PID" 2>/dev/null || true
  rm -f "$STATE_FILE"

  if [[ ! -f "$AUDIO_FILE" ]] || [[ ! -s "$AUDIO_FILE" ]]; then
    exit 0
  fi

  notify-send -a "hypr-voice" -u low -t 4000 "Voice Input" "Transcribing audio..."

  TRANSCRIPT=$(bun run "$HARNESS_DIR/voice.ts" "$AUDIO_FILE" 2>/dev/null || true)
  rm -f "$AUDIO_FILE"

  if [[ -z "$TRANSCRIPT" ]]; then
    notify-send -a "hypr-voice" -u normal -t 4000 "Voice Input" "No speech detected."
    exit 0
  fi

  notify-send -a "hypr-voice" -u normal -t 6000 "Voice Query" "“${TRANSCRIPT}”"

  # Dispatch transcribed command to hypr-harness operator
  bun run "$HARNESS_DIR/cli.ts" "$TRANSCRIPT" >> /tmp/hypr-spotlight.log 2>&1 &
) &

exit 0
