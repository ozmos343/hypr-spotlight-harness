#!/usr/bin/env bash
set -eo pipefail

HARNESS_DIR="$HOME/.config/hypr/harness"
CONSOLE_CLASS="hypr-quake-operator"

# Check if the quake console is already running
if ! hyprctl clients | grep -q "class: ${CONSOLE_CLASS}"; then
  # Spawn onto special:quake_operator
  hyprctl dispatch 'hl.dsp.exec_cmd("[workspace special:quake_operator] kitty --class hypr-quake-operator --title \"Quake Operator Console\" bun run '"$HARNESS_DIR"'/quake_console.ts")'
  sleep 0.25
fi

# Toggle slide-in / slide-out
hyprctl dispatch togglespecialworkspace quake_operator
