#!/usr/bin/env bash
set -eo pipefail

HARNESS_DIR="$HOME/.config/hypr/harness"
UI_DIR="$HARNESS_DIR/ui"
PROMPT_TEXT="ask, run, or generate..."

# Open Wofi with custom spotlight floating pill theme
INPUT=$(echo "" | wofi --dmenu \
  -c "$UI_DIR/wofi.conf" \
  -s "$UI_DIR/style.css" \
  2>/dev/null || true)

# Trim input
INPUT="$(echo -e "${INPUT}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

if [[ -n "$INPUT" ]]; then
  bun run "$HARNESS_DIR/cli.ts" "$INPUT" >> /tmp/hypr-spotlight.log 2>&1 &
fi
